# =========================================================================
# XClientLab - MCP External Servers Environment Variables Template
# Copy this file to mcp/.env or export these variables in your shell environment
# =========================================================================

# --- 1. GitHub MCP Server ---
# Generate at: GitHub -> Settings -> Developer Settings -> Personal Access Tokens (Classic or Fine-grained)
# Required Scopes: repo, read:org, workflow
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- 2. Figma MCP Server ---
# Generate at: Figma -> Account Settings -> Security -> Personal Access Tokens
# Required Permissions: File read, Component read
FIGMA_ACCESS_TOKEN="figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- 3. Atlassian / Jira MCP Server ---
# JIRA_URL: Your Atlassian Cloud domain (e.g. https://your-team.atlassian.net)
# Generate API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL="https://your-domain.atlassian.net"
JIRA_USERNAME="your-email@example.com"
JIRA_API_TOKEN="ATATTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- 4. Slack MCP Server ---
# Create App at: https://api.slack.com/apps
# Bot Token Scopes: channels:history, channels:read, chat:write, users:read
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Team ID: Found in Slack URL (e.g. https://app.slack.com/client/T12345678/...)
SLACK_TEAM_ID="T12345678"

# --- 5. iOS Local Project Root ---
PROJECT_ROOT="."
