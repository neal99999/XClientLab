# =========================================================================
# XClientLab - Fastlane & CI/CD Environment Variables Example
# Copy this file to fastlane/.env.default or add these keys to GitHub Secrets
# =========================================================================

# --- 1. App Store Connect API Key (Recommended for CI/CD) ---
# Create in App Store Connect -> Users and Access -> Integrations -> App Store Connect API
APP_STORE_CONNECT_KEY_ID="D383SF7354"
APP_STORE_CONNECT_ISSUER_ID="69a6de70-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Either provide raw .p8 text or base64-encoded content:
# APP_STORE_CONNECT_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n..."
# APP_STORE_CONNECT_KEY_BASE64="LS0tLS1CRUdJTi..."

# --- 2. Traditional Apple ID Login (Fallback) ---
# APPLE_ID="developer@example.com"
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# --- 3. Code Signing Option A: Base64 Certificate + Provisioning Profile ---
# Encode .p12 certificate: base64 -i distribution.p12 | pbcopy
# BUILD_CERTIFICATE_BASE64="MIACAQ..."
# P12_PASSWORD="your-p12-password"
# Encode profile: base64 -i XClientLab_AppStore.mobileprovision | pbcopy
# BUILD_PROVISION_PROFILE_BASE64="MIAGCS..."
# PROVISIONING_PROFILE_SPECIFIER="XClientLab_AppStore"

# --- 4. Code Signing Option B: Fastlane Match ---
# MATCH_GIT_URL="git@github.com:your-org/certificates.git"
# MATCH_PASSWORD="secret-encryption-password"
# MATCH_GIT_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."

# --- 5. Internal Distribution (Pgyer / 蒲公英) ---
# PGYER_API_KEY="your-pgyer-api-key"

# --- 6. CI Environment Overrides ---
# SIMULATOR_DESTINATION="platform=iOS Simulator,name=iPhone 18 Pro Max"
# CI_KEYCHAIN_NAME="xclientlab_ci_keychain"
