# Fastfile - XClientLab iOS CI/CD Automation
# Supported Platforms: iOS
# Xcode Baseline: Xcode 27+

default_platform(:ios)

platform :ios do
  # =========================================================================
  # MARK: - Helper Methods & Hooks
  # =========================================================================

  def is_ci?
    !ENV["CI"].nil? || !ENV["GITHUB_ACTIONS"].nil?
  end

  def temporary_keychain_name
    ENV["CI_KEYCHAIN_NAME"] || "xclientlab_ci_keychain"
  end

  def load_asc_api_key
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || ENV["ASC_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_KEY_CONTENT"] || ENV["ASC_KEY_CONTENT"]
    key_base64 = ENV["APP_STORE_CONNECT_KEY_BASE64"] || ENV["ASC_KEY_BASE64"]
    key_filepath = ENV["APP_STORE_CONNECT_KEY_FILEPATH"] || ENV["ASC_KEY_PATH"]

    if key_content.nil? && key_base64
      require "base64"
      key_content = Base64.decode64(key_base64)
    end

    if key_id && issuer_id && (key_content || key_filepath)
      UI.message("🔑 Loading App Store Connect API Key (Key ID: #{key_id})...")
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        key_filepath: key_filepath,
        in_house: false
      )
    else
      nil
    end
  end

  def cleanup_temporary_keychain
    keychain_name = temporary_keychain_name
    keychain_paths = [
      File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      File.expand_path("~/Library/Keychains/#{keychain_name}")
    ]

    if keychain_paths.any? { |path| File.exist?(path) }
      UI.message("🧹 Cleaning up temporary CI keychain: #{keychain_name}...")
      delete_keychain(name: keychain_name) rescue nil
    end

    # Clean up temporary certificate and profile files
    [File.expand_path("~/certificate.p12"), File.expand_path("~/profile.mobileprovision")].each do |f|
      File.delete(f) if File.exist?(f) rescue nil
    end
  end

  before_all do |lane|
    setup_ci if is_ci?
  end

  after_all do |lane|
    cleanup_temporary_keychain if is_ci?
  end

  error do |lane, exception|
    cleanup_temporary_keychain if is_ci?
  end

  # =========================================================================
  # MARK: - Code Quality Lanes
  # =========================================================================

  desc "Run SwiftLint static analysis"
  lane :lint do
    if system("which swiftlint > /dev/null 2>&1")
      UI.message("🔍 Running SwiftLint static analysis...")
      sh("swiftlint lint --quiet --no-cache XClientLab")
      UI.success("✅ SwiftLint static analysis passed!")
    else
      UI.important("⚠️ SwiftLint CLI not found in PATH; skipping standalone lint.")
    end
  end

  desc "Run SwiftFormat format check (non-mutating)"
  lane :format_check do
    if system("which swiftformat > /dev/null 2>&1")
      UI.message("🔍 Running SwiftFormat lint...")
      sh("swiftformat --lint XClientLab")
    else
      UI.important("⚠️ SwiftFormat CLI not found in PATH; skipping format check.")
    end
  end

  # =========================================================================
  # MARK: - Testing Lanes
  # =========================================================================

  desc "Run XClientLab unit, snapshot and UI tests via fastlane scan"
  lane :test do |options|
    destination = options[:destination] || ENV.fetch("SIMULATOR_DESTINATION") {
      "platform=iOS Simulator,name=#{ENV.fetch("SIMULATOR_NAME", "iPhone 18 Pro Max")}"
    }

    test_type = (options[:type] || "all").to_s.downcase
    retries = (options[:retry_count] || 2).to_i

    UI.message("🧪 Running tests with destination: #{destination}")

    # 分两次 scan：Xcode 在合并 unit + UI 测试时偶发 test bundle
    # 加载竞争（Unable to initialize test bundle / diagnostics timeout）。
    if test_type == "all" || test_type == "unit"
      UI.message("🧪 [1/2] Running Unit & Snapshot Tests (XClientLabTests)...")
      scan(
        project: "XClientLab.xcodeproj",
        scheme: "XClientLab",
        destination: destination,
        derived_data_path: "DerivedData",
        output_directory: "fastlane/test_output/unit",
        output_types: "html,junit",
        result_bundle: true,
        clean: false,
        code_coverage: true,
        number_of_retries: retries,
        only_testing: ["XClientLabTests"],
        xcargs: "CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -disableAutomaticPackageResolution"
      )
    end

    if test_type == "all" || test_type == "ui"
      UI.message("🧪 [2/2] Running UI Tests (XClientLabUITests)...")
      scan(
        project: "XClientLab.xcodeproj",
        scheme: "XClientLab",
        destination: destination,
        derived_data_path: "DerivedData",
        output_directory: "fastlane/test_output/ui",
        output_types: "html,junit",
        result_bundle: true,
        clean: false,
        code_coverage: true,
        number_of_retries: retries,
        only_testing: ["XClientLabUITests"],
        xcargs: "CODE_SIGNING_ALLOWED=NO -skipPackagePluginValidation -disableAutomaticPackageResolution"
      )
    end

    UI.success("✅ All test suites completed successfully!")
  end

  # =========================================================================
  # MARK: - Build Lanes
  # =========================================================================

  desc "Build the app for the simulator without codesigning"
  lane :build_simulator do
    UI.message("🔨 Compiling XClientLab for iOS Simulator...")
    sh(
      "xcodebuild",
      "-project", "XClientLab.xcodeproj",
      "-scheme", "XClientLab",
      "-sdk", "iphonesimulator",
      "-destination", "generic/platform=iOS Simulator",
      "-derivedDataPath", "DerivedData",
      "CODE_SIGNING_ALLOWED=NO",
      "-skipPackagePluginValidation",
      "-disableAutomaticPackageResolution",
      "build"
    )
    UI.success("✅ Simulator build succeeded!")
  end

  # Alias for backward compatibility
  lane :build do
    build_simulator
  end

  desc "Package Simulator .app into a zip artifact for instant local QA testing"
  lane :package_simulator do
    output_dir = File.expand_path("../build/output", __dir__)
    require "fileutils"
    FileUtils.mkdir_p(output_dir)

    build_simulator

    app_path = Dir.glob("DerivedData/Build/Products/*-iphonesimulator/XClientLab.app").first
    if app_path && File.exist?(app_path)
      zip_output = File.join(output_dir, "XClientLab-Simulator.app.zip")
      zip(
        path: app_path,
        output_path: zip_output
      )
      UI.success("📦 Simulator .app successfully packaged at: #{zip_output}")
    else
      UI.user_error!("❌ Could not find built simulator app in DerivedData/Build/Products/")
    end
  end

  # =========================================================================
  # MARK: - Code Signing Helper
  # =========================================================================

  desc "Setup code signing certificates and provisioning profiles for CI"
  lane :setup_signing do |options|
    type = options[:type] || "appstore" # "appstore", "adhoc", "development"

    if ENV["MATCH_GIT_URL"]
      UI.message("🔐 Configuring code signing via Fastlane Match (#{type})...")
      match(
        type: type,
        readonly: is_ci?,
        app_identifier: "e88ebfa25316fd8c.XClientLab"
      )
    elsif (ENV["BUILD_CERTIFICATE_BASE64"] || ENV["CERTIFICATE_BASE64"]) &&
          (ENV["BUILD_PROVISION_PROFILE_BASE64"] || ENV["PROVISIONING_PROFILE_BASE64"])
      UI.message("🔐 Setting up code signing via Base64 certificate and provisioning profile...")

      require "base64"
      require "securerandom"

      keychain_name = temporary_keychain_name
      keychain_password = ENV["CI_KEYCHAIN_PASSWORD"] || SecureRandom.hex(16)

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      cert_base64 = ENV["BUILD_CERTIFICATE_BASE64"] || ENV["CERTIFICATE_BASE64"]
      cert_p12_path = File.expand_path("~/certificate.p12")
      File.write(cert_p12_path, Base64.decode64(cert_base64))

      p12_password = ENV["P12_PASSWORD"] || ENV["BUILD_CERTIFICATE_PASSWORD"] || ""
      import_certificate(
        keychain_name: keychain_name,
        keychain_password: keychain_password,
        certificate_path: cert_p12_path,
        certificate_password: p12_password
      )

      profile_base64 = ENV["BUILD_PROVISION_PROFILE_BASE64"] || ENV["PROVISIONING_PROFILE_BASE64"]
      profile_path = File.expand_path("~/profile.mobileprovision")
      File.write(profile_path, Base64.decode64(profile_base64))
      install_provisioning_profile(path: profile_path)

      UI.success("✅ Certificates and Provisioning Profiles loaded into #{keychain_name}!")
    else
      UI.important("⚠️ No code signing credentials detected (neither Match nor Base64 certificate secrets).")
      UI.important("  To export a signed IPA for App Store or TestFlight, please configure GitHub Secrets.")
      UI.important("  If running in CI without signing secrets, builds will fall back to unsigned or simulator artifacts.")
    end
  end

  # =========================================================================
  # MARK: - Archive & Package Lanes (gym)
  # =========================================================================

  desc "Archive and export IPA via gym"
  lane :build_ipa do |options|
    export_method = options[:export_method] || "app-store"
    configuration = options[:configuration] || "Release"
    output_dir = File.expand_path("../build/output", __dir__)
    require "fileutils"
    FileUtils.mkdir_p(output_dir)

    UI.message("📦 Building IPA with configuration: #{configuration}, export_method: #{export_method}...")

    # Optional profile specifier mapping
    export_options = {
      compileBitcode: false,
      uploadSymbols: true
    }
    if ENV["PROVISIONING_PROFILE_SPECIFIER"] || ENV["PROVISIONING_PROFILE_NAME"]
      profile_name = ENV["PROVISIONING_PROFILE_SPECIFIER"] || ENV["PROVISIONING_PROFILE_NAME"]
      export_options[:provisioningProfiles] = {
        "e88ebfa25316fd8c.XClientLab" => profile_name
      }
    end

    gym(
      project: "XClientLab.xcodeproj",
      scheme: "XClientLab",
      configuration: configuration,
      export_method: export_method,
      output_directory: output_dir,
      output_name: "XClientLab.ipa",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      export_options: export_options,
      xcargs: "-skipPackagePluginValidation -disableAutomaticPackageResolution"
    )

    UI.success("🎉 IPA successfully generated at: #{File.join(output_dir, 'XClientLab.ipa')}")
  end

  # =========================================================================
  # MARK: - Continuous Delivery Lanes (CD)
  # =========================================================================

  desc "Build and upload release candidate to TestFlight"
  lane :beta do |options|
    UI.message("🚀 Starting TestFlight Delivery Pipeline...")

    # 1. Setup code signing
    setup_signing(type: "appstore")

    # 2. Update build number in CI environment if applicable
    if is_ci? && ENV["GITHUB_RUN_NUMBER"]
      begin
        increment_build_number(
          build_number: ENV["GITHUB_RUN_NUMBER"],
          xcodeproj: "XClientLab.xcodeproj"
        )
        UI.message("🔢 Updated build number to CI run: #{ENV["GITHUB_RUN_NUMBER"]}")
      rescue => e
        UI.important("⚠️ Could not auto-increment build number: #{e.message}")
      end
    end

    # 3. Build IPA
    build_ipa(export_method: "app-store")

    # 4. Upload to TestFlight
    api_key = load_asc_api_key
    changelog_text = options[:changelog] || ENV["RELEASE_CHANGELOG"] || "Automated build via GitHub Actions CI/CD"

    if api_key
      UI.message("🚀 Uploading IPA to TestFlight via App Store Connect API...")
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        changelog: changelog_text
      )
      UI.success("🎉 Successfully uploaded to TestFlight!")
    elsif ENV["APPLE_ID"]
      UI.message("🚀 Uploading IPA to TestFlight via Apple ID credentials...")
      upload_to_testflight(
        username: ENV["APPLE_ID"],
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        changelog: changelog_text
      )
      UI.success("🎉 Successfully uploaded to TestFlight!")
    else
      UI.important("⚠️ App Store Connect credentials not configured; skipped TestFlight upload.")
      UI.important("  IPA is preserved as artifact at build/output/XClientLab.ipa")
    end
  end

  desc "Build and distribute Ad-Hoc IPA for internal testing (e.g. Pgyer)"
  lane :adhoc do |options|
    UI.message("🚀 Starting Ad-Hoc Delivery Pipeline...")

    setup_signing(type: "adhoc")

    if is_ci? && ENV["GITHUB_RUN_NUMBER"]
      begin
        increment_build_number(
          build_number: ENV["GITHUB_RUN_NUMBER"],
          xcodeproj: "XClientLab.xcodeproj"
        )
      rescue => e
        UI.important("⚠️ Could not auto-increment build number: #{e.message}")
      end
    end

    build_ipa(export_method: "ad-hoc")

    # Upload to Pgyer (蒲公英) if API key exists
    pgyer_key = ENV["PGYER_API_KEY"] || ENV["PGYER_APIKEY"]
    if pgyer_key
      ipa_path = File.expand_path("../build/output/XClientLab.ipa", __dir__)
      UI.message("📤 Uploading Ad-Hoc build to Pgyer (蒲公英)...")
      response = sh(
        "curl", "--fail", "--silent", "--show-error",
        "-F", "file=@#{ipa_path}",
        "-F", "_api_key=#{pgyer_key}",
        "https://www.pgyer.com/apiv2/app/upload",
        log: false
      )
      require "json"
      begin
        result = JSON.parse(response)
      rescue JSON::ParserError
        UI.user_error!("Pgyer upload returned a non-JSON response: #{response}")
      end
      UI.user_error!("Pgyer upload failed: #{result["message"] || response}") unless result["code"] == 0
      UI.success("🎉 Successfully published to Pgyer!")
    else
      UI.message("ℹ️ PGYER_API_KEY not configured. Ad-Hoc IPA is available in build/output/XClientLab.ipa")
    end
  end

  desc "Full Production Release Pipeline"
  lane :release do |options|
    UI.message("🚀 Starting Production Release Pipeline...")

    # Run tests first
    test(type: "all")

    # Deliver to TestFlight / App Store
    beta(options)
  end
end
