#!/bin/bash
# .githooks/pre-commit
# XClientLab pre-commit hook: Run SwiftLint on staged Swift files

# 确保在 GUI 工具（如 Xcode、SourceTree）和常规终端下都能找到 Homebrew 安装的工具
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v swiftlint >/dev/null 2>&1; then
    echo "❌ [pre-commit] 未检测到 swiftlint，请先安装: brew install swiftlint"
    exit 1
fi

# 获取暂存区中 XClientLab 目录下新增/修改的 Swift 代码（排除删除的文件）
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^XClientLab/.*\.swift$' || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
    exit 0
fi

echo "🔍 [pre-commit] 正在运行 SwiftLint 静态检查..."

# 将文件名安全读取到数组中（支持空格路径）
SWIFT_FILES=()
while IFS= read -r file; do
    [ -n "$file" ] && SWIFT_FILES+=("$file")
done <<< "$STAGED_SWIFT_FILES"

# 运行 SwiftLint（遵循项目根目录的 .swiftlint.yml 配置）
swiftlint lint --force-exclude "${SWIFT_FILES[@]}"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [pre-commit] SwiftLint 检查未通过（存在 Error 违规），提交已中止！"
    echo "💡 提示: 请修复上方报错后再尝试提交；如紧急情况需跳过，可使用 git commit --no-verify。"
    exit $STATUS
fi

echo "✅ [pre-commit] SwiftLint 检查通过！"
exit 0
